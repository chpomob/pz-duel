{
  "id": "hardcore",
  "label": "Hardcore",
  "tagline": "20 min, tout fait mal",
  "duration_s": 1200,
  "day_length": 2,
  "mods": ["duelcore"],
  "atoms": ["zombie_kill", "explosion", "vehicle_repair"],
  "rules": [
    {"id": "kill_baseline", "when": "atom(zombie_kill)", "every": 1, "effects": [{"kind": "spawn_pop", "n": 3, "distance": [12, 20], "warn_s": 6, "cap_per_min": 90}]},
    {"id": "kill_streak", "when": "atom(zombie_kill).count(5).within(10s)", "effects": [{"kind": "spawn_sprinter", "n": 2, "distance": [12, 20], "warn_s": 10}]},
    {"id": "explosion_horde", "when": "atom(explosion)", "effects": [{"kind": "horde_area", "n": 30, "radius": 20, "distance": [50, 80], "warn_s": 12}]},
    {"id": "repair_noise", "when": "atom(vehicle_repair)", "effects": [{"kind": "noise", "radius": 40, "distance": [30, 60], "warn_s": 0}]}
  ],
  "modifiers": {},
  "budget": {"threats_per_minute": 6, "concurrent_effects": 4, "per_effect_cooldown_s": 20},
  "score": {"points": {"zombie_kill": 1}},
  "disconnect_grace_s": 120,
  "summary": [
    "1 zombie tué → 3 zombies chez l'adversaire (max 90/min)",
    "5 kills en 10 s → 2 rôdeurs rapides",
    "1 explosion → horde de 30",
    "1 réparation de véhicule → bruit sur 40 cases"
  ]
}
